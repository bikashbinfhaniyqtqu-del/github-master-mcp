# GitHub fine-grained personal access token. Keep this secret and never commit it.
GITHUB_TOKEN=github_pat_replace_me

# Transport: stdio (local MCP) or http (remote Streamable HTTP MCP).
GITHUB_MCP_TRANSPORT=stdio

# Remote HTTP mode only: generate with `npm run generate:token` (minimum 32 chars).
# This is separate from GITHUB_TOKEN and protects the public /mcp endpoint.
GITHUB_MCP_ACCESS_TOKEN=replace_with_a_long_random_bearer_token

# Workspace and editing controls.
GITHUB_MCP_WORKSPACE=./workspaces
GITHUB_MCP_MODE=edit
GITHUB_MCP_ALLOW_PUSH=false
GITHUB_MCP_CONFIRMATION_PHRASE=replace_with_a_private_long_confirmation_phrase
GITHUB_MCP_ALLOW_COMMANDS=false
GITHUB_MCP_ALLOWED_SCRIPTS=test,build,lint,typecheck,check
GITHUB_MCP_MAX_FILES=500

# Optional local HTTP port. Render supplies PORT automatically.
GITHUB_MCP_PORT=10000
