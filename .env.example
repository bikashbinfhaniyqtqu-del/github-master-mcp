# GitHub fine-grained Personal Access Token. Keep this secret and never commit it.
GITHUB_TOKEN=github_pat_REPLACE_ME

# Local folder where repositories will be cloned.
GITHUB_MCP_WORKSPACE=./workspaces

# Optional: read-only | edit. Defaults to edit (local file changes only).
GITHUB_MCP_MODE=edit

# Push is disabled unless explicitly enabled.
GITHUB_MCP_ALLOW_PUSH=false

# Set a private phrase locally. For a push, the AI must pass this exact phrase
# in the confirmationPhrase field after you explicitly provide it in chat.
# Do not use a phrase you use anywhere else.
GITHUB_MCP_CONFIRMATION_PHRASE=CHANGE-THIS-TO-A-LONG-PRIVATE-PHRASE

# Running project scripts executes code from the repository. Keep false unless trusted.
GITHUB_MCP_ALLOW_COMMANDS=false

# Comma-separated script names the server is allowed to run when commands are enabled.
GITHUB_MCP_ALLOWED_SCRIPTS=test,build,lint,typecheck,check

# Maximum number of files returned by a project scan.
GITHUB_MCP_MAX_FILES=500
